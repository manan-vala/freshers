# Example .env for local development
# Copy this file to `.env` and fill in real values before running the server.

NODE_ENV=development
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<database>?connection_limit=15&pool_timeout=20
REDIS_URL=redis://localhost:6379
JWT_SECRET=luffy-x-zoro
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=sender@example.com
RESET_TOKEN_EXPIRES_MINUTES=15
